context platform=ios device="iPhone 17 Pro" kind=simulator
open "com.example.flutterRailwayTimetable" --relaunch
wait "台鐵時刻表" 5000
wait "出發站" 3000
snapshot

# 台鐵：設定出發站為「松山」
click "role=\"button\" label=\"出發站 松山\" || role=\"button\" label=\"出發站 台北\" || role=\"button\" label=\"出發站 臺北\""
wait "選擇出發站" 3000
fill "role=\"textfield\" label=\"搜尋站名...\" editable=true" "松山"
wait 800
click "role=\"statictext\" label=\"松山\""
wait "出發站 松山" 3000

# 台鐵：設定到達站為「新竹」
click "role=\"button\" label=\"到達站 新竹\" || role=\"button\" label=\"到達站 高雄\" || role=\"button\" label=\"到達站 臺中\" || role=\"button\" label=\"到達站 台中\""
wait "選擇到達站" 3000
fill "role=\"textfield\" label=\"搜尋站名...\" editable=true" "新竹"
wait 800
click "role=\"statictext\" label=\"新竹\""
wait "到達站 新竹" 3000
snapshot

# 切換到高鐵
click "role=\"text\" label=\"高鐵\nHSR\" || role=\"statictext\" label=\"高鐵\nHSR\""
wait "高鐵時刻表" 3000
snapshot

# 高鐵：設定出發站為「台中」
click "role=\"button\" label=\"出發站 南港\" || role=\"button\" label=\"出發站 台北\" || role=\"button\" label=\"出發站 台中\" || role=\"button\" label=\"出發站 左營\""
wait "選擇出發站" 3000
fill "role=\"textfield\" label=\"搜尋站名...\" editable=true" "台中"
wait 800
click "role=\"statictext\" label=\"台中\""
wait "出發站 台中" 3000

# 高鐵：設定到達站為「左營」
click "role=\"button\" label=\"到達站 台中\" || role=\"button\" label=\"到達站 左營\" || role=\"button\" label=\"到達站 高雄\" || role=\"button\" label=\"到達站 南港\""
wait "選擇到達站" 3000
fill "role=\"textfield\" label=\"搜尋站名...\" editable=true" "左營"
wait 800
click "role=\"statictext\" label=\"左營\""
wait "到達站 左營" 3000
snapshot

# 切換回台鐵，驗證記憶正確
click "role=\"text\" label=\"台鐵\nRail\" || role=\"statictext\" label=\"台鐵\nRail\""
wait "台鐵時刻表" 3000
wait "出發站 松山" 3000
wait "到達站 新竹" 3000
snapshot
close "com.example.flutterRailwayTimetable"
