context platform=ios device="iPhone 17 Pro" kind=simulator

# 測試場景：分類清除近期查詢
# 驗證：在台鐵模式下點「清除全部」，只清除台鐵的近期查詢，高鐵的近期查詢不受影響

open "com.example.flutterRailwayTimetable" --relaunch
wait "台鐵時刻表" 5000

# === 台鐵第一次查詢：臺北 → 板橋 ===
click "role=\"other\" label=\"出發站 新竹\" || role=\"button\" label=\"出發站 新竹\" || label=\"出發站\""
wait "選擇出發站" 3000
click "role=\"statictext\" label=\"臺北市\" || label=\"臺北市\""
wait 1000
click "role=\"statictext\" label=\"臺北\" || label=\"臺北\""
wait "台鐵時刻表" 3000

click "role=\"button\" label=\"到達站 臺中\" || label=\"到達站\""
wait "選擇到達站" 3000
click "role=\"statictext\" label=\"新北市\" || label=\"新北市\""
wait 1000
click "role=\"statictext\" label=\"板橋\" || label=\"板橋\""
wait "台鐵時刻表" 3000

click "label=\"查詢班次\""
wait "台鐵時刻表" 5000

click "role=\"button\" label=\"首頁\nTab 1 of 4\" || label=\"首頁\nTab 1 of 4\""
wait "最近查詢" 3000

# === 台鐵第二次查詢：松山 → 新竹 ===
click "role=\"other\" label=\"出發站 臺北\" || label=\"出發站\""
wait "選擇出發站" 3000
click "role=\"statictext\" label=\"臺北市\" || label=\"臺北市\""
wait 1000
click "role=\"statictext\" label=\"松山\" || label=\"松山\""
wait "台鐵時刻表" 3000

click "role=\"button\" label=\"到達站 板橋\" || label=\"到達站\""
wait "選擇到達站" 3000
click "role=\"textfield\" label=\"搜尋站名...\" || label=\"搜尋站名...\""
wait 500
type "新竹"
wait "北新竹" 3000
click "role=\"statictext\" label=\"新竹\" || label=\"新竹\""
wait "台鐵時刻表" 3000

click "label=\"查詢班次\""
wait "台鐵時刻表" 5000

click "role=\"button\" label=\"首頁\nTab 1 of 4\" || label=\"首頁\nTab 1 of 4\""
wait "最近查詢" 3000

# 截圖確認台鐵近期查詢（應有：松山→新竹、臺北→板橋）
screenshot

# === 切換高鐵：南港 → 台中 ===
click "role=\"statictext\" label=\"高鐵\nHSR\" || label=\"高鐵\nHSR\""
wait "高鐵時刻表" 3000

click "role=\"button\" label=\"到達站 左營\" || label=\"到達站\""
wait "選擇到達站" 3000
click "role=\"statictext\" label=\"台中\" || label=\"台中\""
wait "高鐵時刻表" 3000

click "label=\"查詢班次\""
wait "高鐵時刻表" 5000

click "role=\"button\" label=\"首頁\nTab 1 of 4\" || label=\"首頁\nTab 1 of 4\""
wait "最近查詢" 3000

# 截圖確認高鐵近期查詢（應有：南港→台中）
screenshot

# === 切換回台鐵，確認台鐵記錄存在 ===
click "role=\"statictext\" label=\"台鐵\nRail\" || label=\"台鐵\nRail\""
wait "台鐵時刻表" 3000
wait "最近查詢" 3000

# 截圖確認台鐵近期查詢存在（清除前）
screenshot

# === 清除台鐵近期查詢 ===
click "role=\"statictext\" label=\"清除全部\" || label=\"清除全部\""
wait 1500

# 截圖確認台鐵近期查詢已清空
screenshot

# === 切換高鐵，確認高鐵記錄未受影響 ===
click "role=\"statictext\" label=\"高鐵\nHSR\" || label=\"高鐵\nHSR\""
wait "高鐵時刻表" 3000
wait "最近查詢" 3000

# 截圖確認高鐵近期查詢仍然存在（南港→台中）
screenshot

close "com.example.flutterRailwayTimetable"
