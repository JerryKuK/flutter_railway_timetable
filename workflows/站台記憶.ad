context platform=ios device="iPhone 17 Pro" kind=simulator
open "com.example.flutterRailwayTimetable" --relaunch
wait "台鐵時刻表" 5000
wait "出發站" 3000
click "role=\"button\" label=\"出發站 臺北\" || label=\"出發站 臺北\" || role=\"button\" label=\"出發站 新竹\" || label=\"出發站 松山\" || label=\"出發站 板橋\""
wait "選擇出發站" 3000
fill "role=\"textfield\" label=\"搜尋站名...\" editable=true || label=\"搜尋站名...\" editable=true" "新竹"
wait 800
click "role=\"statictext\" label=\"新竹\" || label=\"新竹\""
wait "出發站 新竹" 3000
click "role=\"button\" label=\"到達站 高雄\" || label=\"到達站 高雄\" || role=\"button\" label=\"到達站 板橋\" || label=\"到達站 板橋\" || role=\"button\" label=\"到達站 臺中\" || label=\"到達站 臺中\""
wait "選擇到達站" 3000
fill "role=\"textfield\" label=\"搜尋站名...\" editable=true || label=\"搜尋站名...\" editable=true" "臺中"
wait 800
click "role=\"statictext\" label=\"臺中\" || label=\"臺中\""
wait "到達站 臺中" 3000
close "com.example.flutterRailwayTimetable"
wait 1500
open "com.example.flutterRailwayTimetable"
wait "台鐵時刻表" 5000
wait "出發站 新竹" 5000
wait "到達站 臺中" 5000
close "com.example.flutterRailwayTimetable"
